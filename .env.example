# Copie para .env.local (desenvolvimento) ou cadastre nas variáveis de ambiente da hospedagem.

# Firebase (Console → Configurações do projeto → Seus apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# YouTube Data API v3 (Google Cloud Console → APIs e serviços → Credenciais)
YOUTUBE_API_KEY=

# Spotify (developer.spotify.com/dashboard → Create app → Client ID / Client secret)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Deezer: a busca pública não precisa de chave.
